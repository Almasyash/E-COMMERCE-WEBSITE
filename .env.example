# Server Environment Variables
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL or SQLite)
# For PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce_db?schema=public"
# For zero-config local development without Postgres installed:
# DATABASE_URL="file:./dev.db"

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_production_change_this_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_production_change_this
JWT_REFRESH_EXPIRES_IN=30d

# Payment Gateways (Razorpay / Stripe)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret

# Vite Client Environment Variables
VITE_API_BASE_URL=http://localhost:5000/api
VITE_APP_NAME="ApexCart"
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
